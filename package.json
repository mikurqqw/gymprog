{
  "name": "ironcycle",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/media.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-legal.mjs && node scripts/media.mjs && tsc -b && vite build && node scripts/seo.mjs && node scripts/finalize.mjs && node scripts/check-build.mjs && node scripts/check-seo.mjs && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "node --test scripts/glob-security.test.mjs scripts/glob-advisories.test.mjs && npm audit --audit-level=high && node scripts/audit-glob-upstream.mjs",
    "build:preview": "node scripts/preview-build.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:security": "node scripts/check-security.mjs && node scripts/check-licenses.mjs && node scripts/check-protected.mjs && node --test scripts/glob-security.test.mjs scripts/glob-advisories.test.mjs",
    "format": "prettier --write src e2e scripts public/sw.js public/theme.js --ignore-unknown",
    "format:check": "prettier --check src e2e scripts public/sw.js public/theme.js --ignore-unknown",
    "check:bundle": "node scripts/check-bundle.mjs",
    "media:capture": "playwright test --config scripts/capture.config.ts",
    "check:content": "node scripts/check-content.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:launch:preview": "node scripts/check-launch.mjs --preview",
    "lighthouse": "node scripts/lighthouse-fixture.mjs && lhci autorun"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "picomatch": "https://raw.githubusercontent.com/mikurqqw/gymprog/d8b81a8c1cc1f32fbbacf75c62bcf0f7fd366415/vendor/ironcycle-picomatch-hardened-4.0.7+ironcycle.1.tgz",
    "minimatch": "^11.0.1",
    "basic-ftp": "^6.2.4"
  }
}
