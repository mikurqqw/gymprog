{
  "name": "ironcycle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/media.mjs && vite --host 127.0.0.1",
    "build": "node scripts/media.mjs && tsc -b && vite build && node scripts/finalize.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "typescript": "6.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "lucide-react": "1.73.0",
    "zod": "4.6.7",
    "idb-keyval": "6.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "vitest": "5.1.0",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "basic-ftp": "^6.2.4"
  }
}
